<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      One entry per supported server line: 10.11 runs on .NET 9 and 12.0 runs
      on .NET 10. The framework is not a preference here, it is what the server
      the assembly is loaded into runs, so the list moves only when the set of
      supported lines does.
    -->
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <RootNamespace>Jellyfin.Plugin.Stats</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <CodeAnalysisRuleSet>../jellyfin.ruleset</CodeAnalysisRuleSet>
    <!--
      packages.lock.json records the graph that was actually restored, direct
      and transitive, and it is tracked. RestoreLockedMode then refuses a
      restore whose graph does not match it, so a package that moved under a
      version range, a feed serving different bytes, or a reference edited
      without regenerating the file stops the build instead of resolving
      quietly and building green.

      The property is set here rather than passed as a locked mode flag on a
      command line, because the packaged build is run by the plugin repository
      manager and this repository passes it no arguments. A property in the
      project holds on every route: the packaged build, the test run, an editor,
      and a command somebody types.

      Changing a reference is therefore two edits, and the second one is:

          dotnet restore Jellyfin.Plugin.Stats/Jellyfin.Plugin.Stats.csproj -p:RestoreForceEvaluate=true
    -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>

  <!--
    The server supplies these assemblies at run time, which is what
    ExcludeAssets runtime says: they are compiled against and never travel in
    the package. The version therefore has to be one the server on that line
    actually loads, and the only version that holds for every server on a line
    is its oldest, so each line references its floor. The floors are declared in
    Directory.Build.props and no version is written here; a literal in this file
    is what the ABI floor jobs refuse. Which floor applies is chosen by the
    framework being built rather than by a symbol in the source.

    Jellyfin.Controller 10.11.x declares a dependency group for net9.0 only and
    12.0.0-rc4 declares one for net10.0 only, so a reference under the wrong
    framework does not resolve at all:

        curl -s https://api.nuget.org/v3-flatcontainer/jellyfin.controller/12.0.0-rc4/jellyfin.controller.nuspec
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinFloorNet9)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinFloorNet9)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinFloorNet10)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinFloorNet10)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    The store. Issue #10 chose a SQLite file of the plugin's own through this
    package, over an Entity Framework context and over the server's database,
    and the reasons are written there.

    It travels in the package, unlike the two references above, because the
    server does not supply it. Neither server line declares it anywhere in the
    graph the plugin restores from:

        grep -c 'Microsoft.Data.Sqlite' Jellyfin.Plugin.Stats/packages.lock.json

    counts it only as this reference and what it pulls in. The closest prior art
    ships its own SQLite stack in its package for the same reason.

    The version follows the server line rather than being one number for both,
    the same way the two references above do. Each line already carries a
    Microsoft.Extensions.* graph pinned to its own major, so a package from the
    other major would pull a second copy of those assemblies into a process that
    already has one.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.11" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
  </ItemGroup>

  <!--
    The native SQLite binary, named here rather than left to the version the
    bundle above asks for. Both server lines resolve it to a version inside a
    high severity advisory, and the restore refuses rather than warning:

        gh api advisories/GHSA-2m69-gcr7-jv3q

    reports SQLitePCLRaw.lib.e_sqlite3 vulnerable at "&lt;= 2.1.11", high
    severity, with no patched version declared.

    2.1.12 is the first version outside that range and the last of that line, so
    this raises the native library and leaves the managed bundle and provider
    where the two Microsoft.Data.Sqlite versions put them.

    This reference exists only for that advisory. When the bundle's own default
    moves past it, this goes, and the way to tell is that removing it leaves the
    restore green.
  -->
  <ItemGroup>
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
  </ItemGroup>

  <!--
    IHostedService, and the AddHostedService that registers one, are declared in
    Microsoft.Extensions.Hosting.Abstractions. The server loads that assembly
    from the ASP.NET Core shared framework it already runs on, but it does not
    declare it as a package dependency:

        grep -oE '<dependency id="[^"]*"' ~/.nuget/packages/jellyfin.controller/10.11.11/jellyfin.controller.nuspec

    so it is absent from the restored graph and the type does not compile
    against Jellyfin.Controller alone. A framework reference resolves it from
    the targeting pack for the compile and adds nothing to the restored package
    graph, which is why packages.lock.json is unchanged by this. A package
    reference would have been the other way to get the type, and it would put a
    copy of an assembly the server already has into the plugin package unless
    every one of its assets were excluded by hand.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SerilogAnalyzer" Version="0.15.0" PrivateAssets="All" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" PrivateAssets="All" />
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" Version="1.1.31" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

  <!--
    The consent wording. Embedded for the reason the page above is: what a
    stored agreement points at has to be what was built and reviewed, and a file
    beside the assembly is a file somebody can edit without a diff.
  -->
  <ItemGroup>
    <None Remove="Privacy\consent.txt" />
    <EmbeddedResource Include="Privacy\consent.txt" />
  </ItemGroup>

  <!--
    The pages assembled from the drawing modules. Pages\pages.targets carries
    the reason and the rule; what is here names which template takes which
    modules, in the order they are laid out, and where the assembled page goes.

    The assembled file is written under the intermediate directory rather than
    beside the template, so nothing generated is tracked and a clone that has
    never been built holds only the source it was written from. The logical name
    is stated, because a resource embedded from that path would otherwise be
    named after the directory the build wrote it into.
  -->
  <Import Project="Pages\pages.targets" />

  <!--
    The rule itself is an input, and not only the files it reads. Without that
    line a change to how a page is assembled leaves the assembled page on disk
    untouched and every check over it green, which is how this was found: the
    rule was deleted, the suite was run, and nothing went red.
  -->
  <Target Name="AssembleThePages" BeforeTargets="PrepareForBuild"
          Inputs="Pages\pages.targets;$(MSBuildProjectFullPath);Pages\usageOverTime.template.html;Pages\charts.js;Pages\usageOverTime.js;Pages\usageOverTimePage.js"
          Outputs="$(IntermediateOutputPath)pages\usageOverTime.html">
    <AssembleAPage Template="Pages\usageOverTime.template.html"
                   Modules="Pages\charts.js;Pages\usageOverTime.js;Pages\usageOverTimePage.js"
                   Destination="$(IntermediateOutputPath)pages\usageOverTime.html" />
  </Target>

  <Target Name="EmbedTheAssembledPages" AfterTargets="AssembleThePages">
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)pages\usageOverTime.html"
                        LogicalName="Jellyfin.Plugin.Stats.Pages.usageOverTime.html" />
    </ItemGroup>
  </Target>

</Project>
