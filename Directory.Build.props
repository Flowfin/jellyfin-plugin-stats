<Project>
    <!--
      The version is written in exactly one tracked file, build.yaml, because that
      is the file the plugin package carries to a server and to a catalogue. Every
      assembly version below is read back out of it, so the packaged version and
      the compiled version cannot drift apart.

      Two matches rather than one capture group: MSBuild converts the returned
      Match to its string, so the first pulls out the version line and the second
      pulls the number out of that line.
    -->
    <PropertyGroup>
        <PluginManifestPath>$(MSBuildThisFileDirectory)build.yaml</PluginManifestPath>
        <PluginManifestText>$([System.IO.File]::ReadAllText($(PluginManifestPath)))</PluginManifestText>
        <PluginManifestVersionLine>$([System.Text.RegularExpressions.Regex]::Match($(PluginManifestText), '(?m)^version:[ ]*"[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+"'))</PluginManifestVersionLine>
        <PluginManifestVersion>$([System.Text.RegularExpressions.Regex]::Match($(PluginManifestVersionLine), '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+'))</PluginManifestVersion>
        <Version>$(PluginManifestVersion)</Version>
        <AssemblyVersion>$(PluginManifestVersion)</AssemblyVersion>
        <FileVersion>$(PluginManifestVersion)</FileVersion>
    </PropertyGroup>

    <!--
      The oldest server release in each supported line, as the package version
      that server ships. A plugin compiled against a later release of a line can
      call something that release added, and it then fails to load for everybody
      still on the floor of that line. Compiling against the floor is what stops
      that, so these are the versions every project here references: the plugin,
      which ships, and the suite, which carries the same assemblies because there
      is no server under it.

      Each floor is written here once and nowhere else. Two projects referenced
      the same two versions before this, so a bump was two edits that could be
      made one at a time, and the ABI floor jobs in .github/workflows/build.yaml
      refuse a project that names a version of its own instead of reading these.

      They sit beside the manifest reader above because the manifest is the other
      half of the same statement: build.yaml declares targetAbi 10.11.0.0 to the
      server, and JellyfinFloorNet9 is the package version that claim is only
      true if the plugin was built against. The floor job compares the two.

      The 12.0 line has published no stable release. Its floor is the oldest
      release candidate that carries a net10.0 target, and it moves to the
      release when there is one:

          curl -s https://api.nuget.org/v3-flatcontainer/jellyfin.controller/index.json
    -->
    <PropertyGroup>
        <JellyfinFloorNet9>10.11.0</JellyfinFloorNet9>
        <JellyfinFloorNet10>12.0.0-rc1</JellyfinFloorNet10>
    </PropertyGroup>

    <!--
      A version that could not be read leaves these properties empty, and the SDK
      then substitutes its own default without saying so. That was measured while
      writing this: a three-part version in build.yaml produced a build that
      succeeded and stamped the SDK default. Refuse instead, so a malformed or
      moved version line stops the build at the file that holds it.

      The condition reads PluginManifestVersion and not Version, because the SDK
      has already filled Version in by the time any target runs, so a guard on
      Version can never fire. That was the first shape of this guard and it
      passed the regression it was written for.
    -->
    <Target Name="RefuseAVersionThatCouldNotBeReadFromTheManifest"
            BeforeTargets="BeforeBuild">
        <Error Condition="'$(PluginManifestVersion)' == ''"
               Text="No four-part version line was found in $(PluginManifestPath). That file is the one place the version is written, and Directory.Build.props reads it from there." />
    </Target>
</Project>
